# AEGIS Example: while Loop Demonstration
# Shows iteration, counter patterns, and accumulation

# Count up from 1 to 5
counter = 1
while counter <= 5
  print counter
  counter = counter + 1
end

# Accumulate a sum: 1 + 2 + 3 + ... + 10
total = 0
i = 1
while i <= 10
  total = total + i
  i = i + 1
end
print total

# Countdown
n = 5
while n > 0
  print n
  n = n - 1
end
